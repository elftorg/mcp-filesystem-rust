# Public host port
MCP_PORT=3001

# Host directory mounted read-only at /data
MCP_DATA_PATH=./data

# Generate a long random value; required by docker-compose.yml
MCP_AUTH_TOKEN=replace-with-at-least-32-random-bytes

# Comma-separated browser origins in addition to same-origin requests
MCP_ALLOWED_ORIGINS=https://chatgpt.com

RUST_LOG=info
